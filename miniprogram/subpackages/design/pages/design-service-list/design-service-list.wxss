.design-list-page {
  padding-bottom: calc(76rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 16rpx 8rpx 30rpx;
}

.eyebrow {
  color: var(--yu-color-text-secondary);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 14rpx;
}

.title {
  color: var(--yu-color-text-primary);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.desc {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: #716d66;
  font-size: 24rpx;
  line-height: 1.65;
}

.total {
  flex: 0 0 auto;
  padding-bottom: 4rpx;
  color: var(--yu-color-green);
  font-size: 23rpx;
  font-weight: 700;
}

.filters {
  width: 100%;
  margin-bottom: 22rpx;
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 64rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(32, 31, 29, .1);
  border-radius: 999rpx;
  color: #77736c;
  background: rgba(255, 255, 255, .68);
  font-size: 23rpx;
  font-weight: 700;
}

.filter.active {
  border-color: var(--yu-color-anchor-dark);
  color: #fff;
  background: var(--yu-color-anchor-dark);
}

.request-list {
  display: grid;
  gap: 18rpx;
}

.request-card,
.state-card {
  border: 1rpx solid rgba(32, 31, 29, .08);
  border-radius: var(--yu-radius-card-lg);
  background: rgba(255, 255, 255, .88);
  box-shadow: var(--yu-shadow-soft);
}

.request-card {
  padding: 24rpx;
}

.request-card:active {
  opacity: .88;
  transform: scale(.994);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--yu-color-yellow);
}

.status-dot.status-proposed {
  background: var(--yu-color-blue);
}

.status-dot.status-confirmed,
.status-dot.status-closed {
  background: var(--yu-color-green);
}

.status {
  color: var(--yu-color-text-primary);
  font-size: 23rpx;
  font-weight: 800;
}

.time {
  margin-left: auto;
  color: var(--yu-color-text-secondary);
  font-size: 21rpx;
}

.card-body {
  display: grid;
  grid-template-columns: 154rpx minmax(0, 1fr);
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
}

.preview {
  position: relative;
  width: 154rpx;
  height: 154rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 50% 44%, #fff 0 30%, #f3f1eb 31% 68%, #faf9f6 69%);
}

.material-stack {
  position: relative;
  width: 100%;
  height: 100%;
}

.material-image {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 66rpx;
  height: 66rpx;
  transform: translate(-50%, -50%);
}

.material-0 { transform: translate(-50%, -102%); }
.material-1 { transform: translate(-8%, -64%); }
.material-2 { transform: translate(-22%, 0%); }
.material-3 { transform: translate(-78%, 0%); }
.material-4 { transform: translate(-92%, -64%); }

.waiting-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.waiting-ring {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border: 1rpx dashed rgba(32, 31, 29, .18);
  border-radius: 50%;
}

.waiting-core {
  color: #8b867d;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-copy {
  min-width: 0;
}

.proposal-title {
  overflow: hidden;
  color: var(--yu-color-text-primary);
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 800;
}

.preferences,
.bead-count {
  margin-top: 10rpx;
  overflow: hidden;
  color: #77726a;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
}

.bead-count {
  color: var(--yu-color-text-secondary);
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(32, 31, 29, .07);
}

.request-id {
  min-width: 0;
  overflow: hidden;
  color: #aaa59c;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 19rpx;
}

.detail-link {
  flex: 0 0 auto;
  color: var(--yu-color-green);
  font-size: 22rpx;
  font-weight: 800;
}

.detail-link text {
  margin-left: 4rpx;
  font-size: 30rpx;
  line-height: 1;
}

.state-card {
  padding: 44rpx 30rpx;
  text-align: center;
}

.state-title {
  color: var(--yu-color-text-primary);
  font-size: 29rpx;
  font-weight: 800;
}

.state-copy {
  max-width: 520rpx;
  margin: 12rpx auto 0;
  color: var(--yu-color-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
}

.empty-card {
  padding-top: 64rpx;
  padding-bottom: 60rpx;
}

.empty-symbol {
  margin-bottom: 20rpx;
  color: #a77a38;
  font-size: 42rpx;
}

.state-action {
  width: 100%;
  min-height: 86rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.state-action.primary {
  color: #fff;
  background: var(--yu-color-anchor-dark);
}

.state-action.secondary {
  border: 1rpx solid rgba(32, 31, 29, .14);
  color: var(--yu-color-anchor-dark);
  background: #fff;
}

@media (max-width: 340px) {
  .card-body {
    grid-template-columns: 132rpx minmax(0, 1fr);
    gap: 18rpx;
  }

  .preview {
    width: 132rpx;
    height: 132rpx;
  }

  .proposal-title {
    font-size: 27rpx;
  }
}
