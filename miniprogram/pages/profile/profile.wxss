page {
  background: var(--yu-color-bg-page);
}

.profile-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.profile-page.is-loading > view:not(.profile-loading) {
  visibility: hidden;
}

.profile-loading {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 178rpx;
  padding: 30rpx 28rpx;
  border: var(--yu-line-hair);
  border-radius: var(--yu-radius-card);
  background: rgba(255, 255, 255, .82);
}

.profile-loading-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--yu-color-bg-soft);
}

.profile-loading-copy {
  flex: 1;
}

.profile-loading-line {
  width: 58%;
  height: 22rpx;
  margin-top: 18rpx;
  border-radius: 6rpx;
  background: var(--yu-color-bg-soft);
}

.profile-loading-line.strong {
  width: 42%;
  height: 30rpx;
  margin-top: 0;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx 26rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 92% 4%, rgba(242, 181, 29, .14), transparent 30%),
    linear-gradient(135deg, rgba(255,255,255,.96), rgba(250,248,242,.82));
}

.hero-main {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  align-items: center;
  gap: 20rpx;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,.9);
  border-radius: 50%;
  color: #fff;
  background:
    radial-gradient(circle at 34% 24%, rgba(255,255,255,.92) 0 12%, rgba(181,193,178,.88) 24%, #7d8977 100%);
  box-shadow: 0 14rpx 34rpx rgba(44, 42, 36, .12);
  font-size: 38rpx;
  font-weight: 900;
}

.profile-avatar.empty-avatar {
  border-color: rgba(218, 216, 210, .9);
  background: rgba(255, 255, 255, .82);
  box-shadow: inset 0 0 0 1rpx rgba(32, 32, 31, .04), 0 12rpx 26rpx rgba(44, 42, 36, .08);
}

.avatar-image image {
  width: 100%;
  height: 100%;
}

.profile-copy {
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-name {
  overflow: hidden;
  color: var(--yu-color-anchor-dark);
  font-size: 34rpx;
  font-weight: 900;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-name.login-name {
  color: var(--yu-color-anchor-dark);
}

.profile-name.login-name:active {
  opacity: .68;
}

.vip-badge {
  flex: none;
  padding: 5rpx 14rpx;
  border-radius: var(--yu-radius-pill);
  color: #fff;
  background: linear-gradient(135deg, #d8a64a, #c08a2f);
  font-size: 17rpx;
  font-weight: 900;
}

.profile-id,
.profile-subtitle {
  overflow: hidden;
  color: var(--yu-color-text-secondary);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-id {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.profile-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.edit-profile {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  min-width: 56rpx;
  height: 38rpx;
  min-height: 38rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: var(--yu-color-green);
  background: transparent;
  box-shadow: none;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.edit-profile::after,
.login-button::after,
.modal-close::after,
.field-action::after,
.avatar-picker::after,
.phone-auth-button::after,
.modal-action-button::after {
  border: 0;
}

.login-button {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  margin: 24rpx 0 0;
  border: 0;
  border-radius: var(--yu-radius-pill);
  color: #fff;
  background: var(--yu-color-anchor-dark);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.profile-nudge {
  margin-top: 22rpx;
  padding: 15rpx 18rpx;
  border-radius: 18rpx;
  color: var(--yu-color-green);
  background: rgba(100, 124, 112, .1);
  font-size: 22rpx;
}

.login-panel {
  margin-top: 20rpx;
  padding: 24rpx;
}

.login-title {
  color: var(--yu-color-anchor-dark);
  font-size: 28rpx;
  font-weight: 900;
}

.login-desc {
  margin-top: 10rpx;
  color: var(--yu-color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.section {
  margin-top: 30rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: var(--yu-color-anchor-dark);
  font-size: 28rpx;
  font-weight: 900;
}

.section-link {
  color: var(--yu-color-text-secondary);
  font-size: 21rpx;
}

.order-status-card {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 4rpx;
  padding: 18rpx 8rpx;
}

.order-status-item {
  position: relative;
  min-height: 108rpx;
  padding-top: 10rpx;
  text-align: center;
}

.order-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 10rpx;
  border: 1rpx solid rgba(185, 150, 98, .14);
  border-radius: 22rpx;
  color: #a77838;
  background:
    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, .96) 0 47%, rgba(232, 216, 188, .28) 48% 50%, rgba(255, 253, 248, .92) 51% 100%);
  box-shadow:
    inset 0 0 0 8rpx rgba(255, 255, 255, .48),
    0 10rpx 24rpx rgba(97, 75, 42, .08);
}

.order-icon::after {
  position: absolute;
  right: 12rpx;
  top: 13rpx;
  width: 8rpx;
  height: 8rpx;
  background: #d8a34c;
  content: "";
  transform: rotate(45deg);
}

.order-icon-core,
.order-icon-mark,
.order-icon-core::before,
.order-icon-core::after,
.order-icon-mark::before,
.order-icon-mark::after {
  position: absolute;
  box-sizing: border-box;
  content: "";
}

.order-icon-pay .order-icon-core {
  left: 17rpx;
  top: 25rpx;
  width: 32rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, .54);
}

.order-icon-pay .order-icon-core::before {
  left: 5rpx;
  top: 7rpx;
  width: 18rpx;
  border-top: 3rpx dashed rgba(140, 117, 86, .58);
}

.order-icon-pay .order-icon-mark {
  right: 14rpx;
  bottom: 13rpx;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid rgba(168, 119, 56, .84);
  border-radius: 50%;
  background: rgba(228, 187, 112, .26);
}

.order-icon-pay .order-icon-mark::before {
  left: 8rpx;
  top: 5rpx;
  width: 8rpx;
  height: 12rpx;
  border-left: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.order-icon-pay .order-icon-mark::after {
  left: 6rpx;
  top: 13rpx;
  width: 12rpx;
  border-top: 3rpx solid currentColor;
}

.order-icon-ship .order-icon-core {
  left: 15rpx;
  top: 25rpx;
  width: 38rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  background: rgba(255, 255, 255, .54);
}

.order-icon-ship .order-icon-core::before {
  left: 13rpx;
  top: 0;
  width: 10rpx;
  height: 18rpx;
  background: linear-gradient(90deg, rgba(217, 162, 72, .92) 0 50%, rgba(247, 222, 170, .92) 51% 100%);
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 74%, 0 100%);
}

.order-icon-ship .order-icon-core::after {
  right: -12rpx;
  top: 13rpx;
  width: 23rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.order-icon-ship .order-icon-mark {
  right: 11rpx;
  top: 35rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.order-icon-receive .order-icon-core {
  left: 18rpx;
  top: 20rpx;
  width: 31rpx;
  height: 39rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, .54);
}

.order-icon-receive .order-icon-core::before {
  left: 10rpx;
  top: 0;
  width: 10rpx;
  height: 18rpx;
  background: linear-gradient(90deg, rgba(217, 162, 72, .92) 0 50%, rgba(247, 222, 170, .92) 51% 100%);
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 74%, 0 100%);
}

.order-icon-receive .order-icon-core::after {
  left: 4rpx;
  bottom: 8rpx;
  width: 17rpx;
  border-top: 3rpx solid rgba(140, 117, 86, .48);
}

.order-icon-receive .order-icon-mark {
  right: 12rpx;
  bottom: 12rpx;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid rgba(140, 117, 86, .68);
  border-radius: 50%;
  background: rgba(255, 253, 248, .92);
}

.order-icon-receive .order-icon-mark::before {
  left: 10rpx;
  top: 5rpx;
  height: 12rpx;
  border-left: 3rpx solid currentColor;
}

.order-icon-receive .order-icon-mark::after {
  left: 7rpx;
  top: 12rpx;
  width: 9rpx;
  height: 9rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.order-icon-done .order-icon-core {
  left: 16rpx;
  top: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid rgba(154, 128, 95, .68);
  border-radius: 50%;
  background: rgba(255, 253, 248, .78);
}

.order-icon-done .order-icon-mark {
  left: 29rpx;
  top: 27rpx;
  width: 19rpx;
  height: 11rpx;
  border-left: 5rpx solid #d79b3f;
  border-bottom: 5rpx solid #d79b3f;
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

.order-icon-after .order-icon-core {
  left: 16rpx;
  top: 17rpx;
  width: 40rpx;
  height: 46rpx;
  border: 3rpx solid currentColor;
  border-radius: 16rpx 16rpx 20rpx 20rpx;
  background: rgba(255, 255, 255, .54);
  clip-path: polygon(50% 0, 92% 16%, 86% 72%, 50% 100%, 14% 72%, 8% 16%);
}

.order-icon-after .order-icon-core::before {
  left: 10rpx;
  top: 12rpx;
  width: 18rpx;
  height: 12rpx;
  border-top: 4rpx solid #d79b3f;
  border-left: 4rpx solid #d79b3f;
  border-radius: 50% 0 0 0;
  transform: rotate(-18deg);
}

.order-icon-after .order-icon-core::after {
  left: 8rpx;
  top: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-left: 4rpx solid #d79b3f;
  border-bottom: 4rpx solid #d79b3f;
  transform: rotate(45deg);
}

.order-icon-after .order-icon-mark {
  left: 29rpx;
  bottom: 11rpx;
  width: 12rpx;
  height: 17rpx;
  border-left: 4rpx solid #a77838;
  border-right: 4rpx solid #a77838;
  transform: rotate(45deg);
}

.order-icon-after .order-icon-mark::after {
  left: -4rpx;
  top: 8rpx;
  width: 16rpx;
  border-top: 4rpx solid #a77838;
}

.order-label {
  color: var(--yu-color-text-regular);
  font-size: 19rpx;
}

.order-badge {
  position: absolute;
  top: 0;
  right: 14rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: var(--yu-radius-pill);
  color: #fff;
  background: var(--yu-color-red);
  font-size: 18rpx;
  line-height: 28rpx;
}

.menu-card {
  margin-top: 22rpx;
  overflow: hidden;
  padding: 0 22rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 108rpx;
  padding: 18rpx 0;
}

.menu-contact-shell {
  position: relative;
}

.menu-contact-hit {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: transparent;
  font-size: 0;
  line-height: 1;
  opacity: 0;
}

.menu-contact-hit::after {
  border: 0;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: transparent;
  font-size: 0;
  line-height: 1;
}

.menu-icon-image {
  display: block;
  width: 100%;
  height: 100%;
}

.menu-title {
  color: var(--yu-color-anchor-dark);
  font-size: 25rpx;
  font-weight: 900;
}

.menu-desc {
  margin-top: 7rpx;
  color: var(--yu-color-text-secondary);
  font-size: 20rpx;
  line-height: 1.35;
}

.menu-right,
.menu-arrow {
  flex: none;
  color: var(--yu-color-text-muted);
  font-size: 21rpx;
  font-weight: 800;
}

.menu-divider {
  height: 1rpx;
  margin-left: 90rpx;
  background: rgba(229, 226, 220, .86);
}

.logout-row .menu-title {
  color: var(--yu-color-red);
}

.modal-mask {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 18rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(28, 30, 27, .34);
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
}

.profile-modal {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: calc(100vh - 110rpx - env(safe-area-inset-top));
  overflow: hidden;
  border-radius: 34rpx 34rpx 0 0;
  background: #fbfaf7;
  box-shadow: 0 -22rpx 60rpx rgba(32, 30, 26, .12);
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: var(--yu-line-hair);
}

.modal-title {
  color: var(--yu-color-anchor-dark);
  font-size: 31rpx;
  font-weight: 900;
}

.modal-desc {
  margin-top: 8rpx;
  color: var(--yu-color-text-secondary);
  font-size: 21rpx;
  line-height: 1.45;
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: var(--yu-color-text-regular);
  background: var(--yu-color-bg-soft);
  font-size: 34rpx;
  line-height: 54rpx;
}

.profile-modal-body {
  flex: 1;
  min-height: 0;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.profile-form-card {
  padding: 4rpx 22rpx;
  border: var(--yu-line-hair);
  border-radius: 26rpx;
  background: rgba(255,255,255,.78);
}

.phone-form-card {
  margin-top: 18rpx;
}

.form-row,
.form-field {
  padding: 20rpx 0;
  border-bottom: var(--yu-line-hair);
}

.profile-form-card .form-row:last-child,
.profile-form-card .form-field:last-child {
  border-bottom: 0;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.field-copy {
  flex: 1;
}

.field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-label {
  color: var(--yu-color-anchor-dark);
  font-size: 25rpx;
  font-weight: 900;
}

.field-hint {
  margin-top: 7rpx;
  color: var(--yu-color-text-secondary);
  font-size: 20rpx;
}

.field-action {
  height: 48rpx;
  min-height: 48rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: var(--yu-radius-pill);
  color: var(--yu-color-green);
  background: rgba(100, 124, 112, .1);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 92rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 50%;
  color: #fff;
  background: var(--yu-color-green);
  font-size: 34rpx;
  font-weight: 900;
}

.avatar-picker image {
  width: 100%;
  height: 100%;
}

.nickname-input,
.phone-value {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  border: var(--yu-line-hair);
  border-radius: 18rpx;
  color: var(--yu-color-anchor-dark);
  background: var(--yu-color-bg-soft);
  font-size: 24rpx;
  box-sizing: border-box;
}

.phone-auth-button {
  width: 100%;
  height: 74rpx;
  min-height: 74rpx;
  margin: 16rpx 0 0;
  border: var(--yu-line-hair);
  border-radius: var(--yu-radius-pill);
  color: var(--yu-color-green);
  background: rgba(255,255,255,.72);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 74rpx;
}

.secondary-button {
  border: var(--yu-line-hair);
  color: var(--yu-color-text-regular);
  background: rgba(255,255,255,.72);
}

.primary-button {
  color: #fff;
  background: var(--yu-color-anchor-dark);
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: var(--yu-line-hair);
}

.modal-action-button {
  flex: 1;
  height: 78rpx;
  min-height: 78rpx;
  margin: 0;
  border-radius: var(--yu-radius-pill);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.lab-tabbar {
  position: fixed;
  left: 34rpx;
  right: 34rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 6rpx;
  padding: 6rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .14);
  border-radius: 30rpx;
  background: rgba(28, 27, 24, .94);
  box-shadow:
    0 14rpx 30rpx rgba(18, 17, 15, .18),
    inset 0 1rpx 0 rgba(255, 255, 255, .16);
  -webkit-backdrop-filter: blur(26rpx) saturate(130%);
  backdrop-filter: blur(26rpx) saturate(130%);
  opacity: 1;
  transform: translateY(0) scale(1);
  transform-origin: center bottom;
  transition: transform .28s cubic-bezier(.22, 1, .36, 1), opacity .22s ease, filter .28s ease;
  will-change: transform, opacity;
}

.lab-tabbar.is-hidden {
  opacity: 0;
  pointer-events: none;
  filter: blur(6rpx);
  transform: translateY(calc(112rpx + env(safe-area-inset-bottom))) scale(.96);
}

.lab-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border-radius: 24rpx;
  color: rgba(255, 255, 255, .78);
  font-size: 19rpx;
  font-weight: 850;
}

.lab-tab.active {
  color: #ffffff;
  font-weight: 950;
  background: rgba(255, 255, 255, .16);
  box-shadow:
    0 8rpx 18rpx rgba(0, 0, 0, .16),
    inset 0 1rpx 0 rgba(255, 255, 255, .20);
}

.lab-tab.center {
  color: rgba(255, 255, 255, .92);
  background: rgba(255, 255, 255, .10);
}

.lab-tab.active.center {
  background: rgba(255, 255, 255, .18);
}

.tab-icon {
  margin-bottom: 5rpx;
  font-size: 27rpx;
  line-height: 1;
}

@media (max-width: 360px) {
  .hero-main {
    grid-template-columns: 94rpx 1fr;
  }

  .profile-avatar {
    width: 94rpx;
    height: 94rpx;
  }

  .edit-profile {
    top: 20rpx;
    right: 20rpx;
    width: 52rpx;
    min-width: 52rpx;
    height: 36rpx;
    min-height: 36rpx;
    font-size: 21rpx;
    line-height: 36rpx;
  }

  .order-label {
    font-size: 18rpx;
  }

  .lab-tabbar {
    left: 24rpx;
    right: 24rpx;
    border-radius: 28rpx;
  }
}

/* WeUI-like profile controls. */
.edit-profile,
.login-button,
.field-action,
.phone-auth-button,
.modal-action-button,
.modal-close {
  box-sizing: border-box;
}

.edit-profile::after,
.login-button::after,
.field-action::after,
.phone-auth-button::after,
.modal-action-button::after,
.modal-close::after {
  border: 0;
}

.edit-profile {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(100, 124, 112, .16);
  border-radius: 999rpx;
  color: var(--yu-color-green);
  background: rgba(255,255,255,.78);
  font-size: 22rpx;
  font-weight: 760;
  line-height: 1;
  white-space: nowrap;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  min-height: 84rpx;
  color: #fff;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f322f 0%, #141614 100%);
  box-shadow: 0 14rpx 32rpx rgba(26, 28, 25, .16);
  line-height: 1;
}

.field-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: 52rpx;
  min-height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(100, 124, 112, .16);
  border-radius: 999rpx;
  color: var(--yu-color-green);
  background: rgba(255,255,255,.72);
  font-size: 21rpx;
  line-height: 1;
  white-space: nowrap;
}

.phone-auth-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 220rpx;
  height: 70rpx;
  min-height: 70rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  line-height: 1;
}

.modal-actions {
  gap: 16rpx;
  padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(32, 32, 31, .08);
  background: rgba(251, 250, 247, .96);
}

.modal-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 78rpx;
  min-height: 78rpx;
  margin: 0;
  border-radius: 999rpx;
  line-height: 1;
}

.edit-profile:active,
.login-button:active,
.field-action:active,
.phone-auth-button:active,
.modal-action-button:active {
  opacity: .86;
  transform: scale(.985);
}

@media (max-width: 360px) {
  .edit-profile {
    width: auto;
    min-width: 0;
    height: 44rpx;
    min-height: 44rpx;
    padding: 0 16rpx;
    font-size: 20rpx;
    line-height: 44rpx;
  }
}

/* Profile edit is a tiny text affordance, not a full capsule CTA. */
.profile-hero .edit-profile {
  width: 56rpx;
  min-width: 56rpx;
  height: 38rpx;
  min-height: 38rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: var(--yu-color-green);
  background: transparent;
  box-shadow: none;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 38rpx;
}

@media (max-width: 360px) {
  .profile-hero .edit-profile {
    width: 52rpx;
    min-width: 52rpx;
    height: 36rpx;
    min-height: 36rpx;
    padding: 0;
    font-size: 21rpx;
    line-height: 36rpx;
  }
}
