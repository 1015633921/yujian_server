page {
  background: var(--yu-color-bg-page);
}

.cart-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.cart-nav {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.nav-title {
  color: var(--yu-color-anchor-dark);
  font-size: 36rpx;
  font-weight: 900;
}

.nav-subtitle {
  margin-top: 8rpx;
  color: var(--yu-color-text-secondary);
  font-size: 22rpx;
}

.manage-button {
  height: 56rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: var(--yu-radius-pill);
  color: var(--yu-color-anchor-dark);
  background: rgba(255, 255, 255, .78);
  box-shadow: var(--yu-shadow-press);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.manage-button::after,
.item-action::after,
.empty-primary::after,
.empty-secondary::after {
  border: 0;
}

.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 8rpx 2rpx 18rpx;
}

.list-title {
  color: var(--yu-color-anchor-dark);
  font-size: 28rpx;
  font-weight: 900;
}

.list-subtitle {
  margin-top: 6rpx;
  color: var(--yu-color-text-secondary);
  font-size: 20rpx;
}

.list-badge {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: var(--yu-radius-pill);
  color: var(--yu-color-green);
  background: rgba(100, 124, 112, .12);
  font-size: 20rpx;
  font-weight: 900;
}

.cart-list {
  display: grid;
  gap: 18rpx;
}

.cart-item {
  position: relative;
  display: grid;
  grid-template-columns: 142rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
}

.item-preview {
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  background: rgba(249, 247, 242, .78);
  box-shadow:
    inset 0 -8rpx 18rpx rgba(111, 105, 91, .07),
    0 8rpx 18rpx rgba(46, 45, 40, .05);
}

.item-preview {
  width: 142rpx;
  height: 116rpx;
}

.tone-blue {
  background: rgba(246, 248, 247, .8);
}

.tone-gold {
  background: rgba(249, 247, 242, .8);
}

.tone-pink {
  background: rgba(250, 246, 244, .8);
}

.tone-clear {
  background: rgba(249, 247, 242, .8);
}

.tone-black {
  background: rgba(241, 239, 234, .82);
}

.item-tray-image {
  position: absolute;
  left: -20rpx;
  top: -32rpx;
  z-index: 0;
  width: 182rpx;
  height: 182rpx;
  opacity: 1;
}

.item-image {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  opacity: .88;
}

.mini-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 96rpx;
  height: 86rpx;
  transform: translate(-50%, -50%) rotate(-8deg);
}

.mini-bead {
  position: absolute;
  left: 36rpx;
  top: 31rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(20, 20, 20, .16), inset 0 0 0 1rpx rgba(255, 255, 255, .58);
  transform-origin: 12rpx 12rpx;
}

.item-main {
  min-width: 0;
}

.item-title {
  overflow: hidden;
  color: var(--yu-color-anchor-dark);
  font-size: 25rpx;
  font-weight: 900;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-spec,
.item-desc,
.item-recipe {
  overflow: hidden;
  color: var(--yu-color-text-secondary);
  font-size: 20rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-spec {
  margin-top: 8rpx;
}

.item-recipe {
  margin-top: 6rpx;
}

.item-desc {
  margin-top: 6rpx;
  color: var(--yu-color-text-regular);
  opacity: .72;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.item-price {
  color: var(--yu-color-anchor-dark);
  font-size: 23rpx;
  font-weight: 900;
}

.cart-label {
  flex: none;
  margin-top: 4rpx;
  color: var(--yu-color-text-secondary);
  font-size: 18rpx;
  font-weight: 800;
}

.item-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: none;
  width: 204rpx;
  gap: 10rpx;
}

.item-action {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 82rpx;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  min-width: 0;
  height: 58rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--yu-radius-pill);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.action-secondary {
  color: var(--yu-color-anchor-dark);
  background: rgba(255, 255, 255, .86);
  box-shadow: inset 0 0 0 1rpx rgba(32, 32, 31, .08), 0 8rpx 18rpx rgba(45, 43, 37, .06);
}

.action-primary {
  flex-basis: 112rpx;
  width: 112rpx;
  color: #fff;
  background: linear-gradient(135deg, #2f322f 0%, #141614 100%);
  box-shadow: 0 12rpx 26rpx rgba(26, 28, 25, .16);
}

.item-delete {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--yu-radius-pill);
  color: var(--yu-color-red);
  background: rgba(200, 59, 61, .08);
  font-size: 19rpx;
  font-weight: 800;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 58rpx;
  padding: 64rpx 38rpx;
  text-align: center;
}

.empty-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 230rpx;
  height: 230rpx;
  border: 1rpx solid rgba(100, 124, 112, .22);
  border-radius: 50%;
  background: radial-gradient(circle, #fbfaf7 0 48%, #eee9df 49% 52%, #fbfaf7 53%);
  box-shadow: inset 0 0 34rpx rgba(255, 255, 255, .9);
}

.empty-brand {
  color: var(--yu-color-anchor-dark);
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
}

.empty-brand-en {
  margin-top: 8rpx;
  color: var(--yu-color-text-muted);
  font-size: 16rpx;
  letter-spacing: 4rpx;
}

.empty-title {
  margin-top: 38rpx;
  color: var(--yu-color-anchor-dark);
  font-size: 34rpx;
  font-weight: 900;
}

.empty-desc {
  max-width: 520rpx;
  margin-top: 16rpx;
  color: var(--yu-color-text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
}

.empty-primary,
.empty-secondary {
  width: 480rpx;
}

.empty-primary {
  margin-top: 36rpx;
}

.empty-secondary {
  margin-top: 16rpx;
}

@media (max-width: 360px) {
  .cart-item {
    grid-template-columns: 116rpx minmax(0, 1fr);
    gap: 14rpx;
    padding: 18rpx;
  }

  .item-preview {
    width: 116rpx;
    height: 102rpx;
  }

  .item-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 10rpx;
  }

  .item-actions {
    width: 196rpx;
    gap: 8rpx;
  }

  .item-action {
    flex-basis: 80rpx;
    width: 80rpx;
    font-size: 21rpx;
  }

  .action-primary {
    flex-basis: 108rpx;
    width: 108rpx;
  }

  .list-head {
    align-items: flex-start;
    flex-direction: column;
  }
}

.manage-button:active,
.item-action:active {
  opacity: .86;
  transform: scale(.985);
}

.cart-list {
  gap: 22rpx;
}

.cart-item {
  position: relative;
  display: block;
  padding: 14rpx 14rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(32, 32, 31, .06);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 18rpx 52rpx rgba(38, 35, 30, .07);
}

.cart-workbench-btn,
.cart-delete-btn {
  position: absolute;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  top: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border: 0;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
  color: var(--yu-color-anchor-dark);
  line-height: 1;
}

.cart-workbench-btn {
  left: 24rpx;
  color: #8f7048;
}

.cart-delete-btn {
  right: 24rpx;
}

.cart-action-image {
  display: block;
  width: 100%;
  height: 100%;
}

.item-preview {
  position: relative;
  width: 100%;
  height: 374rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffdfa 0%, #fbf8f1 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(32, 32, 31, .05),
    inset 0 -12rpx 24rpx rgba(111, 105, 91, .05);
}

.cart-tray-fallback {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 0;
  width: 348rpx;
  height: 348rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, .98) 0 30%, rgba(246, 242, 232, .72) 31% 32%, rgba(255, 253, 248, .96) 33% 56%, rgba(235, 224, 205, .36) 57% 59%, rgba(252, 249, 242, .96) 60% 100%);
  box-shadow:
    inset 0 0 0 2rpx rgba(166, 148, 105, .08),
    inset 0 -18rpx 36rpx rgba(150, 130, 92, .08),
    0 18rpx 42rpx rgba(52, 45, 34, .08);
  transform: translate(-50%, -50%);
}

.cart-tray-fallback::before {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 54%;
  height: 54%;
  border: 2rpx solid rgba(143, 130, 96, .13);
  border-radius: 50%;
  content: "";
  transform: translate(-50%, -50%);
}

.cart-tray-fallback::after {
  position: absolute;
  left: 50%;
  bottom: 38rpx;
  width: 82rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(186, 143, 70, .32);
  content: "";
  transform: translateX(-50%);
}

.item-tray-image {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 1;
  width: 390rpx;
  height: 390rpx;
  opacity: .98;
  transform: translate(-50%, -50%);
}

.cart-plan-name {
  flex: none;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  color: rgba(27, 28, 26, .86);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.mini-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 360rpx;
  height: 360rpx;
  transform: translate(-50%, -50%);
}

.mini-ring::after {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 50%;
  height: 50%;
  border: 2rpx dashed rgba(169, 151, 111, .16);
  border-radius: 50%;
  content: "";
  transform: translate(-50%, -50%);
}

.mini-bead {
  position: absolute;
  z-index: 2;
  overflow: hidden;
  border-radius: 50%;
  box-shadow:
    inset -2rpx -4rpx 8rpx rgba(30, 30, 30, .12),
    0 3rpx 8rpx rgba(32, 32, 31, .12);
}

.mini-bead-image,
.mini-bead-dot {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.mini-bead-image {
  background: transparent;
  transform: scale(1.08);
}

.mini-bead-dot {
  background: radial-gradient(circle at 32% 26%, #fff 0 12%, #d8cfc3 18% 58%, rgba(0, 0, 0, .18) 100%);
}

.item-main {
  display: none;
}

.cart-info-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 98rpx;
  padding: 16rpx 16rpx 2rpx;
  box-sizing: border-box;
  text-align: center;
}

.cart-info-row::before {
  display: none;
}

.cart-meta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 100%;
  min-width: 0;
}

.cart-created-time {
  flex: 0 0 auto;
  color: rgba(91, 86, 76, .48);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.cart-row-price {
  position: static;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 122rpx;
  height: 58rpx;
  margin-left: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: var(--yu-radius-pill);
  color: rgba(40, 31, 23, .90);
  background: rgba(237, 222, 202, .72);
  box-shadow: none;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.cart-row-action {
  margin-left: 12rpx;
  padding-left: 12rpx;
  border-left: 1rpx solid rgba(255, 255, 255, .28);
  font-size: 20rpx;
  font-weight: 760;
  opacity: .88;
}

.cart-item.checkout-loading {
  pointer-events: none;
}

.cart-checkout-mask {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100vw;
  height: 100vh;
  background: rgba(251, 250, 247, .68);
  backdrop-filter: blur(12rpx);
}

.cart-checkout-loading {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(32, 32, 31, .08);
  border-radius: 999rpx;
  color: rgba(34, 34, 31, .78);
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 16rpx 42rpx rgba(45, 43, 37, .12);
  font-size: 23rpx;
  font-weight: 760;
}

.cart-checkout-spinner {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid rgba(32, 32, 31, .12);
  border-top-color: rgba(32, 32, 31, .62);
  border-radius: 50%;
  animation: cart-spin 780ms linear infinite;
}

@keyframes cart-spin {
  to {
    transform: rotate(360deg);
  }
}

.list-subtitle {
  display: none;
}

.item-delete {
  z-index: 5;
}

@media (max-width: 360px) {
  .cart-item {
    display: block;
    padding: 12rpx;
  }

  .item-preview {
    width: 100%;
    height: 330rpx;
  }

  .cart-tray-fallback {
    width: 304rpx;
    height: 304rpx;
  }

  .item-tray-image {
    width: 344rpx;
    height: 344rpx;
  }

  .mini-ring {
    width: 320rpx;
    height: 320rpx;
  }

  .cart-row-price {
    min-width: 106rpx;
    height: 50rpx;
    padding: 0 18rpx;
    font-size: 23rpx;
  }

  .cart-workbench-btn,
  .cart-delete-btn {
    top: 22rpx;
    width: 52rpx;
    height: 52rpx;
    min-width: 0;
    padding: 0;
    border-radius: 18rpx;
  }

  .cart-action-image {
    width: 100%;
    height: 100%;
  }

  .cart-plan-name {
    font-size: 21rpx;
    line-height: 1.2;
  }

  .cart-workbench-btn {
    left: 22rpx;
  }

  .cart-delete-btn {
    right: 22rpx;
  }

  .cart-created-time {
    font-size: 17rpx;
  }

  .cart-info-row {
    gap: 8rpx;
    min-height: 86rpx;
    padding: 14rpx 4rpx 0;
  }

  .cart-meta-row {
    gap: 12rpx;
  }
}
