<view class="cart-page yu-page">
  <view class="cart-nav">
    <view>
      <view class="nav-title">购物车</view>
      <view class="nav-subtitle">共 {{items.length}} 个定制方案</view>
    </view>
  </view>

  <block wx:if="{{items.length}}">
    <view class="list-head">
      <view>
        <view class="list-title">定制方案</view>
        <view class="list-subtitle">每个方案可单独修改或结算；灵感收藏不会出现在这里。</view>
      </view>
      <view class="list-badge">{{items.length}} 个</view>
    </view>

    <view class="cart-list">
      <view wx:for="{{items}}" wx:key="key" class="cart-item yu-card yu-card-pressable {{checkoutLoadingKey == item.key ? 'checkout-loading' : ''}}" data-key="{{item.key}}" bindtap="checkoutDesign">
        <view class="cart-workbench-btn" data-key="{{item.key}}" catchtap="editDesign">工作台</view>
        <view class="cart-delete-btn" data-key="{{item.key}}" catchtap="removeItem">删除</view>
        <view class="item-preview tone-{{item.tone}}">
          <view class="cart-tray-fallback"></view>
          <image class="item-tray-image" src="/assets/workspace/tray-yustream-transparent-user-20260701-v6.webp" mode="aspectFit" />
          <view class="cart-plan-name">{{item.planName}}</view>
          <view class="mini-ring">
            <view wx:for="{{item.miniBeads}}" wx:key="index" class="mini-bead" style="{{item.style}}">
              <image wx:if="{{item.src}}" class="mini-bead-image" src="{{item.src}}" mode="aspectFill" />
              <view wx:else class="mini-bead-dot"></view>
            </view>
          </view>
        </view>

        <view wx:if="{{item.createdTime}}" class="cart-created-time">{{item.createdTime}}</view>
        <view class="item-price cart-row-price">
          <text class="cart-row-amount">¥{{item.priceText}}</text>
          <text class="cart-row-action">{{checkoutActionText}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state yu-card">
    <view class="empty-ring">
      <text class="empty-brand">宇涧</text>
      <text class="empty-brand-en">CART</text>
    </view>
    <view class="empty-title">购物车还是空的</view>
    <view class="empty-desc">只有在 DIY 工作台点击“加入购物车”的手串方案，才会出现在这里。</view>
    <button class="yu-button yu-button-primary empty-primary" bindtap="continueDiy">去 DIY 工作台</button>
    <button class="yu-button yu-button-secondary empty-secondary" bindtap="goHome">返回首页</button>
  </view>

  <view wx:if="{{checkoutLoadingKey}}" class="cart-checkout-mask">
    <view class="cart-checkout-loading">
      <view class="cart-checkout-spinner"></view>
      <view>{{checkoutLoadingText}}</view>
    </view>
  </view>
</view>
