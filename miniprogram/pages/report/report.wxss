.result-page {
  position: relative;
  overflow-x: hidden;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.result-page::before {
  display: none;
}

.result-nav {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 70rpx 1fr 70rpx;
  align-items: center;
  min-height: 72rpx;
}

.nav-back,
.nav-share {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: var(--yu-line-hair);
  border-radius: 50%;
  color: var(--yu-color-text-regular);
  background: rgba(255, 255, 255, .82);
  box-shadow: var(--yu-shadow-press);
}

.nav-back {
  font-size: 44rpx;
  line-height: 1;
}

.nav-share {
  justify-self: end;
  overflow: visible;
  border: 0;
  background: transparent;
  box-shadow: 0 9rpx 22rpx rgba(132, 91, 36, 0.13);
}

.nav-share-image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.nav-title {
  color: var(--yu-color-anchor-dark);
  text-align: center;
  font-size: 28rpx;
  font-weight: 650;
  letter-spacing: 0;
}

.result-stepper {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6rpx;
  margin-top: 26rpx;
  padding: 0 10rpx;
}

.step-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: var(--yu-color-text-muted);
  font-size: 18rpx;
}

.step-item::before {
  position: absolute;
  top: 17rpx;
  left: -50%;
  width: 100%;
  height: 1rpx;
  background: var(--yu-color-line);
  content: "";
  z-index: -1;
}

.step-item:first-child::before {
  display: none;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 1rpx solid var(--yu-color-line);
  border-radius: 50%;
  color: #9b9a94;
  background: rgba(255, 255, 255, .92);
  font-size: 19rpx;
  font-weight: 700;
}

.step-label {
  white-space: nowrap;
}

.score-help {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  margin-left: 3rpx;
  border: 1rpx solid currentColor;
  border-radius: 50%;
  font-size: 16rpx;
  line-height: 1;
}

.step-item.done {
  color: var(--yu-color-green);
}

.step-item.done .step-dot {
  color: #fff;
  border-color: var(--yu-color-green);
  background: var(--yu-color-green);
}

.step-item.active {
  color: var(--yu-color-blue);
  font-weight: 700;
}

.step-item.active .step-dot {
  color: #fff;
  border-color: var(--yu-color-blue);
  background: var(--yu-color-blue);
  box-shadow: 0 8rpx 18rpx rgba(54, 92, 156, .18);
}

.result-head {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding-right: 142rpx;
}

.result-share {
  position: absolute;
  top: 50%;
  right: 0;
  width: 120rpx;
  height: 88rpx;
  border: 0;
  background: transparent;
  box-shadow: none;
  transform: translateY(-50%);
}

.result-share-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 120rpx;
  height: 56rpx;
  border: 1rpx solid rgba(157, 122, 63, .18);
  border-radius: 999rpx;
  color: #82652F;
  background: rgba(157, 122, 63, .08);
  box-shadow: 0 8rpx 18rpx rgba(132, 91, 36, .08);
}

.result-share.is-loading .result-share-visual {
  opacity: .62;
}

.result-share-icon {
  box-sizing: border-box;
  position: relative;
  width: 22rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
}

.result-share-icon::before,
.result-share-icon view {
  position: absolute;
  right: 3rpx;
  left: 3rpx;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.result-share-icon::before {
  top: 4rpx;
}

.result-share-icon view {
  bottom: 3rpx;
}

.result-share-label {
  font-size: 21rpx;
  font-weight: 760;
  line-height: 1;
  white-space: nowrap;
}

.result-title {
  color: var(--yu-color-anchor-dark);
  font-size: 42rpx;
  font-weight: 850;
  letter-spacing: 0;
}

.result-subtitle {
  margin-top: 10rpx;
  color: rgba(32, 32, 31, .68);
  font-size: 23rpx;
}

.result-kicker,
.section-kicker {
  color: var(--yu-color-green);
  font-size: 19rpx;
  font-weight: 850;
  letter-spacing: 0;
}

.result-kicker {
  margin-bottom: 10rpx;
}

.answer-hero {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  padding: 34rpx 30rpx 30rpx;
  border: 1rpx solid rgba(32, 32, 31, .08);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(20, 20, 20, .045);
}

.answer-title {
  margin-top: 14rpx;
  color: var(--yu-color-anchor-dark);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.28;
  letter-spacing: 0;
}

.answer-summary {
  margin-top: 18rpx;
  color: var(--yu-color-text-regular);
  font-size: 25rpx;
  line-height: 1.72;
}

.answer-summary text {
  display: block;
}

.answer-summary-action {
  margin-top: 8rpx;
}

.key-element-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 28rpx;
  border-top: 1rpx solid var(--yu-color-line);
  border-bottom: 1rpx solid var(--yu-color-line);
}

.key-element-item {
  box-sizing: border-box;
  min-width: 0;
  min-height: 112rpx;
  padding: 20rpx 12rpx;
  border-right: 1rpx solid var(--yu-color-line);
}

.key-element-item:last-child {
  border-right: 0;
}

.key-element-label {
  color: rgba(32, 32, 31, .62);
  font-size: 20rpx;
  line-height: 1.3;
}

.key-element-value {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 9rpx;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.25;
}

.key-element-status {
  margin-top: 7rpx;
  color: rgba(32, 32, 31, .62);
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.3;
}

.balance-answer {
  box-sizing: border-box;
  min-height: 112rpx;
  margin-top: 22rpx;
  padding: 16rpx 18rpx 15rpx;
  border-left: 3rpx solid var(--yu-color-blue);
  background: rgba(54, 92, 156, .035);
}

.balance-answer-head {
  display: grid;
  grid-template-columns: auto auto minmax(0, 1fr) 28rpx;
  align-items: baseline;
  gap: 12rpx;
}

.balance-answer-label {
  color: var(--yu-color-anchor-dark);
  font-size: 22rpx;
  font-weight: 800;
}

.balance-answer-score {
  justify-self: end;
  color: rgba(32, 32, 31, .58);
  font-size: 21rpx;
  font-weight: 760;
}

.balance-answer-score text {
  font-size: 18rpx;
  font-weight: 700;
}

.balance-answer-score .balance-score-label {
  margin-right: 6rpx;
  color: rgba(32, 32, 31, .52);
}

.balance-answer-status {
  color: var(--yu-color-anchor-dark);
  font-size: 23rpx;
  font-weight: 850;
}

.balance-answer-help {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid rgba(54, 92, 156, .45);
  border-radius: 50%;
  color: var(--yu-color-blue);
  font-size: 15rpx;
  line-height: 1;
}

.balance-answer-copy {
  margin-top: 7rpx;
  color: rgba(32, 32, 31, .68);
  font-size: 20rpx;
  line-height: 1.5;
}

.balance-answer-note {
  margin-top: 5rpx;
  color: rgba(32, 32, 31, .66);
  font-size: 19rpx;
  line-height: 1.48;
}

.advice-section {
  position: relative;
  z-index: 1;
  margin-top: 46rpx;
}

.section-title,
.details-title {
  margin-top: 10rpx;
  color: var(--yu-color-anchor-dark);
  font-size: 32rpx;
  font-weight: 880;
  line-height: 1.32;
  letter-spacing: 0;
}

.advice-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--yu-color-line);
}

.advice-row {
  display: grid;
  grid-template-columns: 136rpx minmax(0, 1fr);
  gap: 22rpx;
  align-items: start;
  min-height: 72rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--yu-color-line);
}

.advice-label {
  color: var(--yu-color-text-secondary);
  font-size: 22rpx;
  font-weight: 750;
}

.advice-value {
  color: var(--yu-color-anchor-dark);
  font-size: 25rpx;
  font-weight: 720;
  line-height: 1.55;
}

.advice-caution .advice-label {
  color: #9B6B52;
}

.state-prompt {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 54rpx minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  margin-top: 30rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--yu-color-line);
  border-bottom: 1rpx solid var(--yu-color-line);
}

.state-prompt-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #fff;
  background: var(--yu-color-green);
  font-size: 30rpx;
  line-height: 1;
}

.state-prompt-copy {
  min-width: 0;
}

.state-prompt-title {
  color: var(--yu-color-anchor-dark);
  font-size: 24rpx;
  font-weight: 800;
}

.state-prompt-desc {
  margin-top: 6rpx;
  color: rgba(32, 32, 31, .60);
  font-size: 20rpx;
  line-height: 1.45;
}

.state-prompt-action {
  color: var(--yu-color-green);
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
}

.why-section {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  padding-top: 34rpx;
  border-top: 1rpx solid var(--yu-color-line);
}

.why-summary {
  margin-top: 16rpx;
  color: var(--yu-color-text-regular);
  font-size: 24rpx;
  line-height: 1.62;
}

.evidence-group-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}

.evidence-group-label view {
  color: var(--yu-color-anchor-dark);
  font-size: 23rpx;
  font-weight: 820;
}

.evidence-group-label text {
  min-width: 0;
  color: rgba(32, 32, 31, .62);
  font-size: 20rpx;
  line-height: 1.4;
  text-align: right;
}

.evidence-group-label.chart-label {
  margin-top: 34rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--yu-color-line);
}

.adjustment-list {
  margin-top: 12rpx;
  border-top: 1rpx solid var(--yu-color-line);
}

.adjustment-row {
  display: grid;
  grid-template-columns: 12rpx 54rpx minmax(0, 1fr);
  gap: 14rpx;
  align-items: center;
  min-height: 82rpx;
  border-bottom: 1rpx solid var(--yu-color-line);
}

.adjustment-mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.adjustment-element {
  color: var(--yu-color-anchor-dark);
  font-size: 28rpx;
  font-weight: 850;
}

.adjustment-copy {
  min-width: 0;
  color: var(--yu-color-anchor-dark);
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.4;
}

.adjustment-copy text {
  display: block;
  margin-top: 4rpx;
  color: rgba(32, 32, 31, .60);
  font-size: 21rpx;
  font-weight: 500;
}

.energy-stage {
  position: relative;
  z-index: 1;
  width: 580rpx;
  height: 450rpx;
  margin: 24rpx auto 0;
}

.energy-ring-wrap {
  position: absolute;
  top: 74rpx;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .38);
  box-shadow: inset 0 0 0 18rpx rgba(255, 255, 255, .5);
  transform: translateX(-50%);
}

.energy-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  box-shadow:
    0 18rpx 42rpx rgba(35, 38, 34, .06),
    inset 0 0 0 1rpx rgba(255, 255, 255, .8);
}

.energy-ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: var(--yu-color-bg-page-warm);
  box-shadow:
    inset 0 0 0 1rpx rgba(229, 226, 220, .86),
    0 12rpx 28rpx rgba(50, 50, 45, .04);
}

.energy-label {
  color: var(--yu-color-anchor-dark);
  font-size: 27rpx;
  font-weight: 850;
}

.energy-ring-caption {
  margin-top: 8rpx;
  color: var(--yu-color-text-secondary);
  font-size: 20rpx;
  line-height: 1.3;
}

.element-orbit {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  min-width: 86rpx;
}

.element-name {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: var(--yu-color-text-regular);
  background: rgba(255, 255, 255, .86);
  box-shadow: 0 8rpx 18rpx rgba(30, 30, 30, .05);
  font-size: 22rpx;
  font-weight: 700;
}

.element-percent {
  color: var(--yu-color-anchor-dark);
  font-size: 23rpx;
  font-weight: 750;
}

.element-wood {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.element-fire {
  top: 116rpx;
  right: 6rpx;
}

.element-earth {
  right: 76rpx;
  bottom: 50rpx;
}

.element-metal {
  bottom: 50rpx;
  left: 76rpx;
}

.element-water {
  top: 116rpx;
  left: 6rpx;
}

.summary-card {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  padding: 30rpx;
}

.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.summary-title {
  color: var(--yu-color-anchor-dark);
  font-size: 31rpx;
  font-weight: 800;
}

.summary-meta {
  margin-top: 8rpx;
  color: var(--yu-color-text-secondary);
  font-size: 22rpx;
}

.balance-badge {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: var(--yu-radius-pill);
  color: var(--yu-color-blue);
  background: rgba(54, 92, 156, .08);
  font-size: 21rpx;
  font-weight: 750;
  white-space: nowrap;
}

.summary-copy {
  margin-top: 24rpx;
  color: var(--yu-color-text-regular);
  font-size: 25rpx;
  line-height: 1.72;
}

.details-section {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--yu-color-line);
  border-bottom: 1rpx solid var(--yu-color-line);
}

.details-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  padding: 30rpx 0;
}

.details-toggle > view:first-child {
  min-width: 0;
}

.details-subtitle {
  margin-top: 8rpx;
  color: rgba(32, 32, 31, .68);
  font-size: 21rpx;
  line-height: 1.45;
}

.details-toggle-action {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--yu-color-text-secondary);
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.details-toggle-icon {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(32, 32, 31, .12);
  border-radius: 50%;
  color: var(--yu-color-anchor-dark);
  background: #fff;
  font-size: 32rpx;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 220ms ease;
}


.result-bottom {
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  width: 100%;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(32, 32, 31, .08);
  background: rgba(247, 246, 242, .98);
  box-shadow: 0 -10rpx 28rpx rgba(20, 20, 20, .05);
}

.result-disclaimer {
  margin: 28rpx 12rpx 0;
  color: rgba(32, 32, 31, .68);
  text-align: center;
  font-size: 21rpx;
  line-height: 1.65;
}

.result-actions {
  display: grid;
  grid-template-columns: 210rpx 1fr;
  gap: 18rpx;
  align-items: center;
}

.result-secondary {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  border: 1rpx solid rgba(32, 32, 31, .12);
  border-radius: 999rpx;
  color: var(--yu-color-anchor-dark);
  background: rgba(255, 255, 255, .86);
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: var(--yu-shadow-press);
}

.result-secondary::after {
  display: none;
}

.result-submit {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  font-size: 28rpx;
}

@media (max-width: 350px) {
  .answer-hero {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .answer-title {
    font-size: 34rpx;
  }

  .key-element-item {
    padding-right: 8rpx;
    padding-left: 8rpx;
  }

  .key-element-label {
    font-size: 18rpx;
  }

  .key-element-value {
    font-size: 24rpx;
  }

  .balance-answer-head {
    grid-template-columns: auto 1fr 28rpx;
    gap: 8rpx;
  }

  .balance-answer-status {
    grid-column: 2;
    grid-row: 1;
    font-size: 20rpx;
  }

  .balance-answer-score {
    grid-column: 1 / 4;
    grid-row: 2;
    justify-self: start;
    margin-top: 4rpx;
  }

  .balance-answer-help {
    grid-column: 3;
    grid-row: 1;
  }

  .advice-row {
    grid-template-columns: 116rpx minmax(0, 1fr);
    gap: 16rpx;
  }

  .state-prompt {
    grid-template-columns: 48rpx minmax(0, 1fr);
  }

  .state-prompt-action {
    grid-column: 2;
  }

  .result-actions {
    grid-template-columns: 176rpx minmax(0, 1fr);
    gap: 12rpx;
  }

  .result-submit {
    font-size: 26rpx;
  }

  .details-toggle-action {
    gap: 4rpx;
    font-size: 18rpx;
  }

  .details-toggle-icon {
    width: 48rpx;
    height: 48rpx;
  }
}

.empty-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-card {
  width: 100%;
  padding: 44rpx 32rpx;
  text-align: center;
}

.empty-title {
  color: var(--yu-color-anchor-dark);
  font-size: 34rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 14rpx;
  color: var(--yu-color-text-secondary);
  font-size: 24rpx;
}

.empty-button {
  margin-top: 34rpx;
}

.report-poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 2180px;
  pointer-events: none;
}

.poster-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(34rpx + env(safe-area-inset-top)) 34rpx calc(34rpx + env(safe-area-inset-bottom));
  background: rgba(20, 20, 20, .48);
}

.poster-modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 96vh;
  padding: 28rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: var(--yu-color-bg-page-warm);
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, .18);
}

.poster-modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.poster-modal-title {
  color: var(--yu-color-anchor-dark);
  font-size: 32rpx;
  font-weight: 850;
}

.poster-modal-sub {
  margin-top: 8rpx;
  color: var(--yu-color-text-secondary);
  font-size: 22rpx;
}

.poster-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  color: var(--yu-color-text-secondary);
  font-size: 44rpx;
  line-height: 1;
}

.poster-preview-scroll {
  display: block;
  width: 100%;
  height: 760rpx;
  max-height: 68vh;
  margin-top: 24rpx;
  border-radius: 24rpx;
  background: #F7F6F2;
  box-shadow: 0 16rpx 42rpx rgba(32, 32, 31, .12);
  overflow: hidden;
}

.poster-preview {
  display: block;
  width: 100%;
  min-height: 760rpx;
  background: #F7F6F2;
}

.poster-actions {
  display: grid;
  grid-template-columns: 188rpx minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.poster-secondary,
.poster-primary {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 84rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: var(--yu-radius-pill);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.poster-secondary::after,
.poster-primary::after {
  border: 0;
}

.poster-secondary {
  border: 1rpx solid rgba(32,32,31,.1);
  color: var(--yu-color-text-regular);
  background: rgba(255,255,255,.86);
}

.poster-primary {
  color: #fff;
  background: var(--yu-color-anchor-dark);
  box-shadow: 0 12rpx 26rpx rgba(32,32,31,.16);
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 20, 20, .42);
}

.wrist-modal {
  width: 100%;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--yu-color-bg-page-warm);
  box-shadow: 0 -18rpx 56rpx rgba(0, 0, 0, .12);
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.modal-title {
  color: var(--yu-color-anchor-dark);
  font-size: 34rpx;
  font-weight: 820;
}

.modal-sub {
  margin-top: 8rpx;
  color: var(--yu-color-text-secondary);
  font-size: 23rpx;
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  color: var(--yu-color-text-secondary);
  font-size: 44rpx;
  line-height: 1;
}

.wrist-ruler-value {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10rpx;
  margin-top: 28rpx;
  color: var(--yu-color-anchor-dark);
}

.wrist-ruler-number {
  font-family: "DIN Alternate", "SF Pro Display", "PingFang SC", sans-serif;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
}

.wrist-ruler-unit {
  padding-bottom: 10rpx;
  color: var(--yu-color-text-secondary);
  font-size: 28rpx;
  font-weight: 700;
}

.wrist-ruler-wrap {
  position: relative;
  margin-top: 22rpx;
  height: 150rpx;
  overflow: hidden;
  border: var(--yu-line-hair);
  border-radius: 32rpx;
  background:
    linear-gradient(90deg, rgba(255,255,255,.94), rgba(250,248,242,.8), rgba(255,255,255,.94)),
    rgba(255, 255, 255, .88);
}

.wrist-ruler-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 150rpx;
  white-space: nowrap;
}

.wrist-ruler-track {
  display: inline-flex;
  align-items: flex-start;
  height: 150rpx;
  box-sizing: border-box;
}

.wrist-ruler-tick {
  position: relative;
  display: inline-flex;
  justify-content: center;
  height: 116rpx;
  padding-top: 28rpx;
  box-sizing: border-box;
}

.tick-line {
  width: 2rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(107, 112, 101, .34);
}

.wrist-ruler-tick.middle .tick-line {
  height: 34rpx;
  background: rgba(107, 112, 101, .46);
}

.wrist-ruler-tick.major .tick-line {
  height: 48rpx;
  background: rgba(48, 52, 46, .62);
}

.tick-label {
  position: absolute;
  top: 86rpx;
  left: 50%;
  transform: translateX(-50%);
  color: var(--yu-color-text-secondary);
  font-size: 22rpx;
  font-weight: 700;
}

.wrist-ruler-pointer {
  position: absolute;
  top: 14rpx;
  bottom: 18rpx;
  left: 50%;
  z-index: 3;
  width: 4rpx;
  border-radius: 999rpx;
  background: #1f211e;
  box-shadow: 0 10rpx 22rpx rgba(31, 33, 30, .16);
  transform: translateX(-50%);
  pointer-events: none;
}

.wrist-ruler-pointer::before {
  position: absolute;
  top: -2rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #1f211e;
  content: "";
  transform: translateX(-50%);
}

.wrist-ruler-fade {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 2;
  width: 112rpx;
  pointer-events: none;
}

.wrist-ruler-fade.left {
  left: 0;
  background: linear-gradient(90deg, rgba(250,248,242,.98), rgba(250,248,242,0));
}

.wrist-ruler-fade.right {
  right: 0;
  background: linear-gradient(270deg, rgba(250,248,242,.98), rgba(250,248,242,0));
}

.wrist-ruler-range {
  margin-top: 12rpx;
  color: var(--yu-color-text-muted);
  text-align: center;
  font-size: 22rpx;
}

.bead-size-label {
  margin-top: 28rpx;
  color: var(--yu-color-text-regular);
  font-size: 25rpx;
  font-weight: 760;
}

.bead-size-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.bead-size-option {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border: var(--yu-line-hair);
  border-radius: var(--yu-radius-pill);
  color: var(--yu-color-text-secondary);
  background: rgba(255, 255, 255, .78);
  font-size: 23rpx;
  font-weight: 680;
}

.bead-size-option.active {
  color: #fff;
  border-color: var(--yu-color-blue);
  background: var(--yu-color-blue);
}

.modal-button {
  width: 100%;
  margin-top: 30rpx;
}

.plan-selector-mask {
  z-index: 66;
}

.plan-selector-modal {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 88vh;
  padding: 34rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--yu-color-bg-page-warm);
  box-shadow: 0 -18rpx 56rpx rgba(0, 0, 0, .12);
}

.plan-selector-head {
  flex: 0 0 auto;
  padding: 0 4rpx 22rpx;
}

.plan-selector-scroll {
  flex: 1 1 auto;
  min-height: 0;
  max-height: 980rpx;
}

.plan-option {
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(32, 32, 31, .09);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .9);
  box-shadow: 0 8rpx 24rpx rgba(20, 20, 20, .04);
}

.plan-option.recommended {
  border: 2rpx solid rgba(100, 124, 112, .5);
  background: #fff;
}

.plan-option-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-option-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--yu-color-anchor-dark);
  font-size: 30rpx;
  font-weight: 820;
}

.plan-recommended-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #fff;
  background: var(--yu-color-green);
  font-size: 18rpx;
  font-weight: 760;
}

.plan-option-subtitle {
  margin-top: 8rpx;
  color: var(--yu-color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.plan-option-arrow {
  flex: 0 0 auto;
  color: var(--yu-color-anchor-dark);
  font-size: 32rpx;
  line-height: 1;
}

.plan-preview-images {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.plan-preview-image {
  box-sizing: border-box;
  width: 76rpx;
  height: 76rpx;
  margin-right: -8rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  background: var(--yu-color-bg-soft);
}

.plan-option-materials {
  margin-top: 18rpx;
  overflow: hidden;
  color: var(--yu-color-text-regular);
  font-size: 23rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-option-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  color: var(--yu-color-text-muted);
  font-size: 20rpx;
}

.plan-option-meta text + text::before {
  margin-right: 12rpx;
  color: rgba(32, 32, 31, .24);
  content: "·";
}

.plan-option-price {
  margin-left: auto;
  color: var(--yu-color-anchor-dark);
  font-size: 23rpx;
  font-weight: 820;
}

.plan-option-meta .plan-option-price::before {
  display: none;
}

.plan-revise-button {
  flex: 0 0 auto;
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
  border: 1rpx solid rgba(32, 32, 31, .12);
  border-radius: 999rpx;
  color: var(--yu-color-anchor-dark);
  background: rgba(255, 255, 255, .86);
  font-size: 24rpx;
  font-weight: 720;
}

.plan-revise-button::after {
  display: none;
}

@media (max-width: 340px) {
  .result-page {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .energy-stage {
    width: 100%;
    height: 470rpx;
  }

  .energy-ring-wrap {
    width: 304rpx;
    height: 304rpx;
  }

  .energy-ring {
    width: 264rpx;
    height: 264rpx;
  }

  .energy-ring-inner {
    width: 194rpx;
    height: 194rpx;
  }

  .element-fire {
    right: 0;
  }

  .element-water {
    left: 0;
  }
}
