<view class="result-page yu-page" wx:if="{{report}}">
  <view class="result-head">
    <view>
      <view class="result-kicker">专属搭配报告</view>
      <view class="result-title">你的搭配方向</view>
      <view class="result-subtitle">先看结论，再了解测算依据</view>
    </view>
    <view class="nav-share result-share yu-pressable {{posterGenerating ? 'is-loading' : ''}}" bindtap="shareReport" aria-role="button" aria-label="生成报告海报" aria-disabled="{{posterGenerating}}">
      <view class="result-share-visual">
        <view class="result-share-icon" aria-hidden="true"><view></view></view>
        <text class="result-share-label">{{posterGenerating ? '生成中' : '生成海报'}}</text>
      </view>
    </view>
  </view>

  <view class="answer-hero">
    <view class="section-kicker">核心结论</view>
    <view class="answer-title">{{viewReport.styleAnswer.headline}}</view>
    <view class="answer-summary">
      <text>{{viewReport.styleAnswer.summaryLead}}</text>
      <text class="answer-summary-action">{{viewReport.styleAnswer.summaryAdvice}}</text>
    </view>

    <view class="key-element-grid">
      <view wx:for="{{viewReport.keyElements}}" wx:key="label" class="key-element-item">
        <view class="key-element-label">{{item.label}}</view>
        <view class="key-element-value" style="color: {{item.color}};">
          <text>{{item.name}}</text><text>{{item.percent}}%</text>
        </view>
        <view class="key-element-status">{{item.status}}</view>
      </view>
    </view>

    <view class="balance-answer yu-pressable" bindtap="showBalanceIndexInfo" aria-role="button" aria-label="查看元素分布均衡度说明">
      <view class="balance-answer-head">
        <view class="balance-answer-label">元素分布：</view>
        <view class="balance-answer-status">{{viewReport.statusText}}</view>
        <view class="balance-answer-score"><text class="balance-score-label">均衡度</text>{{viewReport.score}}<text>/100</text></view>
        <view class="balance-answer-help">?</view>
      </view>
      <view class="balance-answer-copy">{{viewReport.balanceExplanation}}</view>
      <view class="balance-answer-note">{{viewReport.balanceStrategyNote}}</view>
    </view>
  </view>

  <view class="advice-section">
    <view class="section-kicker">搭配答案</view>
    <view class="section-title">{{viewReport.styleAnswer.adviceTitle}}</view>
    <view class="advice-list">
      <view wx:for="{{viewReport.styleAnswer.advice}}" wx:key="label" class="advice-row advice-{{item.tone}}">
        <view class="advice-label">{{item.label}}</view>
        <view class="advice-value">{{item.value}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{viewReport.needsMoreInput}}" class="state-prompt yu-pressable" bindtap="supplementAssessment" aria-role="button" aria-label="补充当前状态和直觉色彩">
    <view class="state-prompt-mark">+</view>
    <view class="state-prompt-copy">
      <view class="state-prompt-title">补充当前状态，让搭配建议更精准</view>
      <view class="state-prompt-desc">约需 10 秒 · {{viewReport.missingInputText}}</view>
    </view>
    <view class="state-prompt-action">去补充 →</view>
  </view>

  <view class="why-section">
    <view class="section-kicker">推荐依据</view>
    <view class="section-title">为什么这样推荐</view>
    <view class="why-summary">{{viewReport.styleAnswer.evidence}}</view>

    <view class="evidence-group-label">
      <view>调节策略</view>
      <text>{{viewReport.styleAnswer.recommendedElementsText}} 的作用</text>
    </view>

    <view class="adjustment-list" wx:if="{{viewReport.styleAnswer.adjustmentElements.length}}">
      <view wx:for="{{viewReport.styleAnswer.adjustmentElements}}" wx:key="name" class="adjustment-row">
        <view class="adjustment-mark" style="background: {{item.color}};"></view>
        <view class="adjustment-element">{{item.name}}</view>
        <view class="adjustment-copy">
          <view>{{item.role}}</view>
          <text>{{item.description}}</text>
        </view>
      </view>
    </view>

    <view class="evidence-group-label chart-label">
      <view>当前元素占比</view>
    </view>

    <view class="energy-stage">
      <view
        wx:for="{{viewReport.elements}}"
        wx:key="key"
        class="element-orbit element-{{item.key}}"
      >
        <view class="element-name">{{item.name}}</view>
        <view class="element-percent">{{item.percent}}%</view>
      </view>

      <view class="energy-ring-wrap" aria-label="五行元素占比图">
        <view class="energy-ring" style="background: {{viewReport.ringGradient}};">
          <view class="energy-ring-inner">
            <view class="energy-label">五行占比</view>
            <view class="energy-ring-caption">元素结构</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="details-section">
    <view class="details-toggle yu-pressable" bindtap="openReportBasis" aria-role="button" aria-label="查看完整测算依据">
      <view>
        <view class="section-kicker">可选阅读</view>
        <view class="details-title">测算依据</view>
        <view class="details-subtitle">已综合出生信息{{viewReport.hasMbtiInput ? '、性格偏好' : ''}}、星座{{viewReport.hasLiveInput ? '与当前状态' : ''}}</view>
      </view>
      <view class="details-toggle-action">
        <text>查看完整依据</text>
        <view class="details-toggle-icon">›</view>
      </view>
    </view>
  </view>
  <view class="result-disclaimer">本分析仅用于传统文化体验、审美搭配与个性化 DIY 参考，不构成命理定论、医疗健康建议或效果承诺。</view>

  <view class="result-bottom">
    <view class="result-actions">
      <button class="result-secondary" bindtap="restartAssessment">重新分析</button>
      <button class="yu-button yu-button-primary result-submit" bindtap="openWristModal">查看专属手串方案</button>
    </view>
  </view>
</view>

<view class="empty-page yu-page" wx:else>
  <view class="empty-card yu-card">
    <view class="empty-title">还没有分析报告</view>
    <view class="empty-desc">先完成基础信息填写，再查看元素比例参考。</view>
    <button class="yu-button yu-button-primary empty-button" bindtap="goBack">返回分析</button>
  </view>
</view>

<canvas
  id="reportPosterCanvas"
  class="report-poster-canvas"
  type="2d"
  canvas-id="reportPosterCanvas"
></canvas>

<view wx:if="{{showPosterModal}}" class="poster-mask" catchtap="closePosterModal">
  <view class="poster-modal" catchtap="noop">
    <view class="poster-modal-head">
      <view>
        <view class="poster-modal-title">专属报告海报</view>
        <view class="poster-modal-sub">已隐藏个人输入 · 长按图片可转发或保存</view>
      </view>
      <view class="poster-close" bindtap="closePosterModal">×</view>
    </view>
    <scroll-view class="poster-preview-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <image class="poster-preview" src="{{posterPath}}" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="previewPoster"></image>
    </scroll-view>
    <view class="poster-actions">
      <button class="poster-secondary" bindtap="closePosterModal">稍后</button>
      <button class="poster-primary" loading="{{posterSaving}}" disabled="{{posterSaving}}" bindtap="savePosterImage">保存海报</button>
    </view>
  </view>
</view>

<view wx:if="{{showWristModal}}" class="modal-mask" bindtap="closeWristModal">
  <view class="wrist-modal" catchtap="noop">
    <view class="modal-head">
      <view>
        <view class="modal-title">选择手腕大小</view>
        <view class="modal-sub">左右滑动软尺，松手后自动吸附到 0.1cm</view>
      </view>
      <view class="modal-close" bindtap="closeWristModal">×</view>
    </view>

    <view class="wrist-ruler-value">
      <text class="wrist-ruler-number">{{wristRulerValue}}</text>
      <text class="wrist-ruler-unit">cm</text>
    </view>
    <view class="wrist-ruler-wrap">
      <view class="wrist-ruler-pointer"></view>
      <view class="wrist-ruler-fade left"></view>
      <view class="wrist-ruler-fade right"></view>
      <scroll-view
        class="wrist-ruler-scroll"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        bounces="{{true}}"
        scroll-left="{{wristRulerScrollLeft}}"
        bindscroll="onWristRulerScroll"
        bindtouchstart="onWristRulerTouchStart"
        bindtouchend="onWristRulerTouchEnd"
        bindtouchcancel="onWristRulerTouchEnd"
      >
        <view class="wrist-ruler-track" style="padding-left:{{wristRulerSidePadding}}px;padding-right:{{wristRulerSidePadding}}px;">
          <view
            wx:for="{{wristRulerTicks}}"
            wx:key="index"
            class="wrist-ruler-tick {{item.className}}"
            style="width:{{wristRulerTickWidth}}px;"
          >
            <view class="tick-line"></view>
            <view class="tick-label">{{item.label}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="wrist-ruler-range">{{wristRulerRangeText}}</view>

    <view class="bead-size-label">偏好珠径</view>
    <view class="bead-size-options">
      <view wx:for="{{beadSizeOptions}}" wx:key="*this" class="bead-size-option {{beadSize === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectBeadSize">{{item}}mm</view>
    </view>

    <button class="yu-button yu-button-primary modal-button" loading="{{generating}}" disabled="{{generating}}" bindtap="confirmWristAndRecommend">生成推荐 DIY 手串</button>
  </view>
</view>

<view wx:if="{{showPlanModal}}" class="modal-mask plan-selector-mask" bindtap="closePlanModal">
  <view class="plan-selector-modal" catchtap="noop">
    <view class="modal-head plan-selector-head">
      <view>
        <view class="section-kicker">为你生成 3 种方向</view>
        <view class="modal-title">选择一套继续 DIY</view>
        <view class="modal-sub">材料、配饰和结构都可以进入工作台后继续修改</view>
      </view>
      <view class="modal-close" bindtap="closePlanModal">×</view>
    </view>

    <scroll-view class="plan-selector-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{recommendationPlans}}"
        wx:for-item="plan"
        wx:key="index"
        class="plan-option yu-pressable {{plan.isRecommended ? 'recommended' : ''}}"
        data-index="{{plan.index}}"
        bindtap="chooseRecommendationPlan"
        aria-role="button"
        aria-label="选择{{plan.title}}方案"
      >
        <view class="plan-option-top">
          <view>
            <view class="plan-option-title">
              <text>{{plan.title}}</text>
              <text wx:if="{{plan.isRecommended}}" class="plan-recommended-tag">推荐</text>
            </view>
            <view class="plan-option-subtitle">{{plan.subtitle}}</view>
          </view>
          <view class="plan-option-arrow">→</view>
        </view>

        <view class="plan-preview-images" wx:if="{{plan.previewImages.length}}">
          <image
            wx:for="{{plan.previewImages}}"
            wx:for-item="imageUrl"
            wx:key="*this"
            class="plan-preview-image"
            src="{{imageUrl}}"
            mode="aspectFill"
            lazy-load
          ></image>
        </view>

        <view class="plan-option-materials">{{plan.materialText}}</view>
        <view class="plan-option-meta">
          <text>{{plan.beadCount}} 颗</text>
          <text>{{plan.accessoryText}}</text>
          <text class="plan-option-price">{{plan.priceText}}</text>
        </view>
      </view>
    </scroll-view>

    <button class="plan-revise-button" bindtap="reviseWristSelection">返回修改手围和珠径</button>
  </view>
</view>
