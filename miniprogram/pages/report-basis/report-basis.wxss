.basis-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.basis-head {
  padding: 28rpx 0 38rpx;
}

.basis-kicker {
  color: var(--yu-color-green);
  font-size: 19rpx;
  font-weight: 850;
}

.basis-title {
  margin-top: 10rpx;
  color: var(--yu-color-anchor-dark);
  font-size: 42rpx;
  font-weight: 880;
  line-height: 1.25;
}

.basis-intro {
  margin-top: 14rpx;
  color: rgba(32, 32, 31, .66);
  font-size: 25rpx;
  line-height: 1.65;
}

.basis-privacy-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 0 0;
  border-top: 1rpx solid rgba(47, 92, 80, .12);
  color: rgba(32, 32, 31, .68);
  font-size: 22rpx;
  line-height: 1.55;
}

.basis-privacy-mark {
  flex: 0 0 auto;
  color: #2F5C50;
  font-weight: 780;
}

.basis-section {
  padding: 34rpx 0;
  border-top: 1rpx solid var(--yu-color-line);
}

.basis-section-head {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: start;
}

.basis-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  color: #75613C;
  background: rgba(157, 122, 63, .10);
  font-size: 18rpx;
  font-weight: 850;
}

.basis-section-title {
  color: var(--yu-color-anchor-dark);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.3;
}

.basis-section-title-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.private-pill {
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(47, 92, 80, .16);
  border-radius: 999rpx;
  color: #2F5C50;
  background: rgba(84, 139, 98, .07);
  font-size: 18rpx;
  font-weight: 720;
  line-height: 1.25;
}

.basis-section-subtitle {
  margin-top: 6rpx;
  color: rgba(32, 32, 31, .66);
  font-size: 22rpx;
  line-height: 1.45;
}

.basis-emphasis {
  margin-top: 22rpx;
  color: var(--yu-color-anchor-dark);
  font-size: 29rpx;
  font-weight: 820;
  line-height: 1.45;
}

.basis-professional-row {
  margin-top: 22rpx;
}

.basis-professional-row text {
  color: rgba(32, 32, 31, .60);
  font-size: 21rpx;
  font-weight: 700;
}

.basis-professional-row view {
  margin-top: 7rpx;
  color: var(--yu-color-anchor-dark);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.45;
}

.basis-facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.basis-time-fact {
  grid-column: 1 / -1;
}

.basis-time-fact view {
  overflow-wrap: normal;
}

.basis-time-explain {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.basis-time-help {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  border: 1rpx solid rgba(32, 32, 31, .20);
  border-radius: 50%;
  color: rgba(32, 32, 31, .68);
  font-size: 18rpx;
  font-weight: 760;
  line-height: 1;
}

.basis-fact {
  min-width: 0;
  padding: 17rpx 14rpx;
  border: 1rpx solid rgba(229, 226, 220, .9);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .62);
}

.basis-fact text,
.basis-info-label {
  color: rgba(32, 32, 31, .60);
  font-size: 21rpx;
  font-weight: 700;
}

.basis-fact view {
  margin-top: 7rpx;
  overflow-wrap: anywhere;
  color: var(--yu-color-anchor-dark);
  font-size: 24rpx;
  font-weight: 780;
  line-height: 1.4;
}

.basis-fact .basis-fact-note {
  display: block;
  margin-top: 6rpx;
  color: rgba(32, 32, 31, .58);
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.45;
}

.mbti-summary-line,
.zodiac-line,
.season-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 22rpx;
}

.mbti-summary-line .basis-emphasis,
.zodiac-line .basis-emphasis,
.season-heading .basis-emphasis {
  margin-top: 0;
}

.mbti-type {
  color: #2F5C50;
  font-size: 34rpx;
  font-weight: 880;
}

.basis-pill,
.season-pill {
  padding: 9rpx 14rpx;
  border: 1rpx solid rgba(47, 92, 80, .16);
  border-radius: 999rpx;
  color: #2F5C50;
  background: rgba(84, 139, 98, .07);
  font-size: 20rpx;
  font-weight: 720;
  line-height: 1.35;
}

.season-pill {
  color: #8F554A;
  border-color: rgba(143, 85, 74, .18);
  background: rgba(199, 91, 75, .07);
}

.basis-copy {
  margin-top: 18rpx;
  color: var(--yu-color-text-regular);
  font-size: 26rpx;
  line-height: 1.62;
}

.basis-note {
  margin-top: 12rpx;
  color: rgba(32, 32, 31, .68);
  font-size: 24rpx;
  line-height: 1.6;
}

.basis-info-row {
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--yu-color-line);
}

.basis-info-row:last-child {
  border-bottom: 0;
}

.basis-info-row.compact {
  padding: 18rpx 0 0;
  border-bottom: 0;
}

.basis-info-content {
  min-width: 0;
  color: var(--yu-color-anchor-dark);
  font-size: 26rpx;
  font-weight: 780;
  line-height: 1.5;
}

.basis-info-content text {
  display: block;
  margin-top: 6rpx;
  color: rgba(32, 32, 31, .64);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.6;
}

.color-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-top: 14rpx;
}

.color-swatch-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.basis-info-content .color-swatch-item text {
  display: inline;
  margin-top: 0;
  color: rgba(32, 32, 31, .66);
  font-size: 20rpx;
  line-height: 1.4;
}

.color-swatch {
  flex: 0 0 auto;
  width: 34rpx;
  height: 22rpx;
  border: 1rpx solid rgba(32, 32, 31, .08);
  border-radius: 999rpx;
}

.basis-empty-line {
  margin-top: 20rpx;
  padding: 18rpx 0;
  color: rgba(32, 32, 31, .62);
  font-size: 24rpx;
  line-height: 1.55;
}

.keyword-tags {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.keyword-tag {
  box-sizing: border-box;
  min-width: 0;
  min-height: 82rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(32, 32, 31, .10);
  border-radius: 14rpx;
  color: var(--yu-color-anchor-dark);
  background: rgba(255, 255, 255, .56);
  font-size: 23rpx;
  font-weight: 780;
  line-height: 1.35;
}

.keyword-tag view {
  margin-top: 4rpx;
  color: rgba(32, 32, 31, .62);
  font-size: 18rpx;
  font-weight: 600;
}

.generation-section {
  border-bottom: 1rpx solid var(--yu-color-line);
}

.basis-report-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0 18rpx;
  color: rgba(32, 32, 31, .60);
  font-size: 22rpx;
  line-height: 1.45;
}

.basis-report-meta view {
  color: var(--yu-color-anchor-dark);
  font-weight: 720;
  text-align: right;
}

.basis-edit-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--yu-color-line);
  border-bottom: 1rpx solid var(--yu-color-line);
}

.basis-edit-entry > view:first-child {
  min-width: 0;
}

.basis-edit-title {
  color: var(--yu-color-anchor-dark);
  font-size: 26rpx;
  font-weight: 820;
  line-height: 1.4;
}

.basis-edit-entry text {
  display: block;
  margin-top: 5rpx;
  color: rgba(32, 32, 31, .60);
  font-size: 21rpx;
  line-height: 1.5;
}

.basis-edit-arrow {
  flex: 0 0 auto;
  color: rgba(32, 32, 31, .56);
  font-size: 36rpx;
  line-height: 1;
}

.experience-note {
  padding: 28rpx 0 0;
  color: rgba(32, 32, 31, .66);
  font-size: 22rpx;
  line-height: 1.65;
}

.basis-empty {
  display: flex;
  min-height: 70vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.basis-empty-title {
  color: var(--yu-color-anchor-dark);
  font-size: 34rpx;
  font-weight: 850;
}

.basis-empty-copy {
  margin-top: 14rpx;
  color: rgba(32, 32, 31, .62);
  font-size: 24rpx;
  line-height: 1.6;
}

.basis-empty-button {
  width: 100%;
  margin-top: 30rpx;
}

@media (max-width: 350px) {
  .basis-title {
    font-size: 38rpx;
  }

  .basis-info-row {
    grid-template-columns: 100rpx minmax(0, 1fr);
    gap: 14rpx;
  }
}
