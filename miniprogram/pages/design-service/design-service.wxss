.page{min-height:100vh;padding:32rpx 28rpx 72rpx;background:var(--yu-color-bg-page-warm,#f8f6f1);color:var(--yu-color-anchor-dark,#201f1d)}
.select-picker{display:block;margin-top:16rpx}.select-value{display:flex;align-items:center;justify-content:space-between;min-height:82rpx;padding:0 20rpx;border:1rpx solid rgba(32,31,29,.13);border-radius:14rpx;color:#201f1d;background:#fbfaf7;font-size:27rpx;font-weight:600}.select-arrow{color:#817c73;font-size:32rpx;font-weight:400}.field-tip{margin-top:12rpx;color:#827d75;font-size:22rpx;font-weight:500}
.empty-action{display:block;width:100%;min-height:76rpx;margin-top:22rpx;border:0;border-radius:999rpx;color:#fff;background:#201f1d;font-size:25rpx;font-weight:800}
.hero{padding:18rpx 12rpx 38rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#817c73}.title{margin-top:16rpx;font-size:44rpx;font-weight:800;letter-spacing:-1rpx}.desc{margin-top:16rpx;color:#716d66;font-size:25rpx;line-height:1.7}.form-card,.status-card,.state-card,.proposal-card,.due-card{box-sizing:border-box;border:1rpx solid rgba(32,31,29,.09);border-radius:24rpx;background:#fff;box-shadow:0 12rpx 32rpx rgba(42,38,30,.04)}.form-card{padding:30rpx}.section-title{font-size:32rpx;font-weight:800}.form-hint,.service-note{margin-top:12rpx;color:#827d75;font-size:23rpx;line-height:1.65}.field{padding:28rpx 0 20rpx;border-bottom:1rpx solid rgba(32,31,29,.08);font-size:25rpx;font-weight:700}.field input,.field textarea{box-sizing:border-box;width:100%;margin-top:16rpx;padding:18rpx 0;border:0;color:#201f1d;background:transparent;font-size:27rpx;font-weight:500}.field textarea{height:132rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.chip{padding:13rpx 18rpx;border:1rpx solid rgba(32,31,29,.13);border-radius:999rpx;color:#716d66;font-size:23rpx;font-weight:500}.chip.active{border-color:#201f1d;color:#fff;background:#201f1d}.primary,.secondary{box-sizing:border-box;min-height:88rpx;margin:0;border:0;border-radius:999rpx;font-size:27rpx;font-weight:800}.primary{color:#fff;background:#201f1d}.secondary{color:#201f1d;border:1rpx solid rgba(32,31,29,.15);background:#fff}.submit{width:100%;margin-top:34rpx}.status-card{display:flex;justify-content:space-between;align-items:center;padding:30rpx}.status-label,.proposal-version,.proposal-date{color:#847f77;font-size:21rpx}.status-title{margin-top:10rpx;font-size:34rpx;font-weight:800}.status-id{max-width:220rpx;color:#847f77;font-size:20rpx;text-align:right;word-break:break-all}.due-card{margin-top:16rpx;padding:20rpx 26rpx;color:#625d56;font-size:23rpx}.state-card{padding:34rpx 28rpx;color:#716d66;font-size:26rpx;line-height:1.6}.section{margin-top:30rpx}.proposal-card{margin-top:18rpx;padding:26rpx}.proposal-head{display:flex;justify-content:space-between;gap:20rpx}.proposal-title{font-size:29rpx;font-weight:800}.proposal-desc{margin-top:16rpx;color:#706b64;font-size:24rpx;line-height:1.65}.proposal-images{margin-top:20rpx;white-space:nowrap}.proposal-image{width:280rpx;height:280rpx;margin-right:14rpx;border-radius:14rpx;background:#eee}.proposal-actions{display:grid;grid-template-columns:1fr 1.25fr;gap:16rpx;margin-top:22rpx}.mask{position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;background:rgba(20,20,20,.4)}.revision-card{width:100%;padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fbfaf7}.revision-card textarea{box-sizing:border-box;width:100%;height:190rpx;margin-top:22rpx;padding:18rpx;border:1rpx solid rgba(32,31,29,.12);border-radius:16rpx;background:#fff;font-size:26rpx}
.proposal-structure{margin-top:20rpx;padding:18rpx;border-radius:18rpx;background:#f8f7f3}.structure-meta{display:flex;justify-content:space-between;color:#716d66;font-size:22rpx;font-weight:700}.structure-ring{position:relative;width:440rpx;height:440rpx;margin:8rpx auto 0;border:1rpx dashed rgba(32,31,29,.12);border-radius:50%;background:radial-gradient(circle,#fff 0 35%,#f6f5f0 36% 70%,#fff 71%)}.structure-bead{position:absolute;width:68rpx;height:68rpx;transform:translate(-50%,-50%)}.workspace-action{width:100%;min-height:82rpx;margin-top:18rpx;border:1rpx solid rgba(32,31,29,.14);border-radius:999rpx;color:#201f1d;background:#fff;font-size:25rpx;font-weight:800}
.confirm-mask{z-index:80}.confirm-card{box-sizing:border-box;width:100%;max-height:92vh;padding:32rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));overflow-y:auto;border-radius:32rpx 32rpx 0 0;background:#fbfaf7}.confirm-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.confirm-eyebrow{margin-bottom:8rpx;color:#9a7138;font-size:19rpx;font-weight:800;letter-spacing:3rpx}.confirm-close{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:50%;color:#706b64;background:#eeece6;font-size:34rpx}.confirm-hint{margin-top:14rpx;color:#777168;font-size:23rpx;line-height:1.6}.confirm-ring{position:relative;width:500rpx;height:500rpx;margin:18rpx auto 0;border:1rpx solid rgba(32,31,29,.08);border-radius:50%;background:radial-gradient(circle,#fff 0 34%,#f4f2ec 35% 68%,#fff 69%)}.confirm-bead{position:absolute;width:76rpx;height:76rpx;transform:translate(-50%,-50%)}.confirm-summary{display:flex;align-items:center;justify-content:space-between;padding:18rpx 4rpx;color:#716d66;font-size:23rpx;font-weight:700}.confirm-price{color:#201f1d;font-size:30rpx;font-weight:900}.confirm-materials{white-space:nowrap}.confirm-material{display:inline-flex;box-sizing:border-box;width:142rpx;margin-right:12rpx;padding:12rpx;vertical-align:top;flex-direction:column;border:1rpx solid rgba(32,31,29,.08);border-radius:16rpx;background:#fff}.confirm-material image{width:116rpx;height:116rpx}.confirm-material text{margin-top:8rpx;overflow:hidden;color:#625d56;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.confirm-actions{margin-top:24rpx}
