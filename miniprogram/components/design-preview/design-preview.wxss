:host {
  display: block;
  width: 560rpx;
  height: 560rpx;
}

.design-preview {
  position: relative;
  display: flex;
  width: 560rpx;
  height: 560rpx;
  max-width: 100%;
  align-items: center;
  justify-content: center;
  overflow: visible;
  background: transparent;
}

.design-preview-tray {
  position: absolute;
  left: -13%;
  top: -13%;
  z-index: 0;
  width: 126%;
  height: 126%;
  background: transparent;
  opacity: .98;
}

.tray-preview-failed {
  border-radius: 50%;
  background: radial-gradient(circle at 42% 32%, #fff 0 18%, #f8f5ed 50%, #e9e2d6 100%);
  box-shadow:
    inset 0 0 0 22rpx rgba(247, 245, 239, .78),
    inset 0 0 0 28rpx rgba(135, 132, 122, .08),
    0 18rpx 42rpx rgba(45, 42, 35, .06);
}

.tray-theme-white.tray-preview-failed {
  background: radial-gradient(circle at 42% 32%, #fff 0 22%, #fafafa 54%, #eeeeec 100%);
}

.tray-theme-black.tray-preview-failed {
  background: radial-gradient(circle at 42% 32%, #343433 0 18%, #222 54%, #111 100%);
  box-shadow:
    inset 0 0 0 22rpx rgba(255, 255, 255, .035),
    inset 0 0 0 28rpx rgba(0, 0, 0, .20),
    0 18rpx 42rpx rgba(0, 0, 0, .12);
}

.design-preview-guide {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 1;
  width: 52%;
  height: 52%;
  border: 2rpx dashed rgba(169, 151, 111, .18);
  border-radius: 50%;
  pointer-events: none;
  transform: translate(-50%, -50%);
}

.design-preview-beads {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  pointer-events: none;
}

.design-preview-bead {
  position: absolute;
  left: 0;
  top: 0;
  overflow: hidden;
  border-radius: 50%;
  box-shadow:
    inset -3rpx -5rpx 9rpx rgba(30, 30, 30, .13),
    0 4rpx 10rpx rgba(32, 32, 31, .12);
}

.design-preview-bead-image,
.design-preview-bead-fallback {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.design-preview-bead-image {
  z-index: 1;
  background: transparent;
  transform: scale(1.08);
}

.design-preview-bead-fallback {
  background: transparent;
}

@media (max-width: 340px) {
  :host,
  .design-preview {
    width: 512rpx;
    height: 512rpx;
  }
}
