<view class="design-preview tray-theme-{{trayTheme}} {{trayFailed ? 'tray-preview-failed' : ''}}">
  <image
    wx:if="{{trayImage && !trayFailed}}"
    class="design-preview-tray"
    src="{{trayImage}}"
    mode="aspectFill"
    binderror="onTrayImageError"
  ></image>
  <view wx:if="{{showGuide}}" class="design-preview-guide" style="{{guideStyle}}"></view>
  <view class="design-preview-beads">
    <view wx:for="{{renderBeads}}" wx:key="key" class="design-preview-bead" style="{{item.style}}">
      <image wx:if="{{item.image_url}}" class="design-preview-bead-image" src="{{item.image_url}}" mode="aspectFit"></image>
      <view wx:else class="design-preview-bead-fallback" style="{{item.fallbackStyle}}"></view>
    </view>
  </view>
</view>
