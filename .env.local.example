APP_ENV=local
DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=yujian_local
MYSQL_USER=填写服务器.env里的MYSQL_USER
MYSQL_PASSWORD=填写服务器.env里的MYSQL_PASSWORD
WECHAT_PAY_TEST_MODE=true
LOGISTICS_SYNC_ENABLED=false
LOGISTICS_SYNC_INTERVAL_SECONDS=1800
LOGISTICS_SYNC_LEASE_SECONDS=3600
LOGISTICS_SYNC_MAX_ATTEMPTS=3
LOGISTICS_SYNC_BATCH_SIZE=50
METRICS_ENDPOINT_ENABLED=false
METRICS_ACCESS_TOKEN=
LOG_LEVEL=INFO
LOG_HASH_SALT=仅在部署环境配置的非公开随机值
COS_REQUEST_TIMEOUT_SECONDS=15
COMMERCE_CHECKOUT_ENABLED=false
WECHAT_PAYMENT_ENABLED=false
REPORT_VERSIONING_V2_ENABLED=false
INVENTORY_RESERVATION_TTL_SECONDS=900
DIY_PUBLIC_SHARE_ENABLED=false
REMOTE_AVATAR_FETCH_ENABLED=false
REMOTE_AVATAR_ALLOWED_HOSTS=thirdwx.qlogo.cn
USER_SESSION_TTL_SECONDS=604800
ALLOW_DEV_WECHAT_LOGIN=true
TRUST_CLOUDBASE_IDENTITY_HEADERS=false
